   el CSS según el fondo (barra lateral oscura, login claro). El mismo dibujo está
   en wwwroot/img/logo-marca.svg para el favicon y los documentos. *@
<svg class="ss-logo" viewBox="0 0 48 48" role="img" aria-label="StockSuper" xmlns="http://www.w3.org/2000/svg">
    <rect class="ss-logo-fondo" width="48" height="48" rx="10" />
    <rect class="ss-logo-capa" x="11" y="10" width="26" height="7" rx="1.5" />
    <rect class="ss-logo-capa" x="11" y="10" width="7" height="17.5" rx="1.5" />
    <rect class="ss-logo-medio" x="11" y="20.5" width="26" height="7" rx="1.5" />
    <rect class="ss-logo-capa" x="30" y="20.5" width="7" height="17.5" rx="1.5" />
    <rect class="ss-logo-capa" x="11" y="31" width="26" height="7" rx="1.5" />
</svg>
