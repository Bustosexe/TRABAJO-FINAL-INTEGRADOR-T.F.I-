@model PieAuditoriaViewModel

@* Trazabilidad del registro: quién lo creó y quién lo modificó *@
<div class="ss-panel mt-3">
    <div class="ss-panel-titulo">Auditoría del registro</div>
    <dl class="row mb-0 p-3 small">
        <dt class="col-sm-4 col-lg-3">Creado por</dt>
        <dd class="col-sm-8 col-lg-9">@Model.CreadoPor, el @Model.FechaCreacion.AHoraArgentina().ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-4 col-lg-3">Última modificación</dt>
        <dd class="col-sm-8 col-lg-9 mb-0">
            @if (Model.FechaModificacion.HasValue)
            {
                <text>@Model.ModificadoPor, el @Model.FechaModificacion.Value.AHoraArgentina().ToString("dd/MM/yyyy HH:mm")</text>
            }
            else
            {
                <text>Sin modificaciones</text>
            }
        </dd>
    </dl>
</div>