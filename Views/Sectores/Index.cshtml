@model IEnumerable<SectorDeposito>
@{
    ViewData["Title"] = "Sectores de depósito";
    var usuarios = (Dictionary<string, string>)ViewData["Usuarios"]!;
    var conteo = (Dictionary<int, int>)ViewData["Conteo"]!;
    var buscar = ViewData["Buscar"] as string;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="ss-titulo mb-1">Sectores de depósito</h1>
        <div class="ss-subtitulo">Lugares físicos donde se almacenan los pallets de su sucursal.</div>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Nuevo sector</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5 col-lg-4">
        <input name="buscar" value="@buscar" class="form-control" placeholder="Buscar por sector, pasillo o estante" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="ss-panel">
    <div class="table-responsive">
        <table class="table ss-tabla table-hover mb-0">
            <thead>
                <tr>
                    <th>Sector</th>
                    <th>Pasillo</th>
                    <th>Estante</th>
                    <th class="text-end">Pallets</th>
                    <th>Última acción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="fw-semibold">@s.NombreSector</td>
                        <td>@s.Pasillo</td>
                        <td>@s.Estante</td>
                        <td class="text-end">@(conteo.TryGetValue(s.Id, out var total) ? total : 0)</td>
                        <td class="ss-auditoria">@ServicioAuditoria.UltimaAccion(s, usuarios)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Eliminar" asp-route-id="@s.Id" method="post"
                                      data-titulo="Eliminar sector"
                                      data-confirmar="Se eliminará el sector '@s.NombreSector'. Esta acción no se puede deshacer."
                                      data-si="Eliminar">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center ss-subtitulo py-4">No hay sectores para mostrar. Cree el primero para poder ingresar pallets.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>