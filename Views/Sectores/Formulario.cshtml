@model SectorDeposito
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo sector" : "Editar sector";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">@ViewData["Title"]</h1>
            <div class="ss-subtitulo">Pasillo y estante son opcionales; sirven para ubicar el pallet con precisión.</div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@(esNuevo ? null : Model.Id)" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="NombreSector" class="form-label"></label>
                            <input asp-for="NombreSector" class="form-control" autofocus />
                            <span asp-validation-for="NombreSector" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Pasillo" class="form-label"></label>
                            <input asp-for="Pasillo" class="form-control" />
                            <span asp-validation-for="Pasillo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Estante" class="form-label"></label>
                            <input asp-for="Estante" class="form-control" />
                            <span asp-validation-for="Estante" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        @if (!esNuevo && ViewData["Pie"] is PieAuditoriaViewModel pie)
        {
            <partial name="_PieAuditoria" model="pie" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}