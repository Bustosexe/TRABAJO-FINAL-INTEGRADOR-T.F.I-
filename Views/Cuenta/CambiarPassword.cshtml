@model CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    var esObligatorio = (bool)(ViewData["EsObligatorio"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">Cambiar contraseña</h1>
            <div class="ss-subtitulo">
                @if (esObligatorio)
                {
                    <text>Por seguridad, debe reemplazar la contraseña temporal antes de continuar.</text>
                }
                else
                {
                    <text>Elija una contraseña que no utilice en otros sistemas.</text>
                }
            </div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="CambiarPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="PasswordActual" class="form-label"></label>
                        <input asp-for="PasswordActual" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="PasswordActual" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordNueva" class="form-label"></label>
                        <input asp-for="PasswordNueva" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                        <span asp-validation-for="PasswordNueva" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar contraseña</button>
                        @if (!esObligatorio)
                        {
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}