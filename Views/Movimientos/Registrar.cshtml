@using System.Text.Json
@model MovimientoFormViewModel
@{
    ViewData["Title"] = "Registrar movimiento";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">Registrar movimiento</h1>
            <div class="ss-subtitulo">
                Una entrada suma unidades al pallet y una salida las resta. Queda registrado con su cuenta y la hora.
            </div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="Registrar" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="PalletId" class="form-label"></label>
                            <select asp-for="PalletId" asp-items="Model.Pallets" class="form-select" autofocus>
                                <option value="">Seleccione...</option>
                            </select>
                            <div id="disponible" class="form-text d-none"></div>
                            <span asp-validation-for="PalletId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoMovimiento" class="form-label"></label>
                            <select asp-for="TipoMovimiento" class="form-select">
                                <option value="">Seleccione...</option>
                                <option value="1">Entrada (suma unidades)</option>
                                <option value="2">Salida (resta unidades)</option>
                            </select>
                            <span asp-validation-for="TipoMovimiento" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Motivo" class="form-label"></label>
                            <select asp-for="Motivo" class="form-select">
                                <option value="">Seleccione...</option>
                                @foreach (var opcion in Model.Motivos)
                                {
                                    <option value="@((int)opcion.Valor)" data-tipos="@opcion.Tipos">@opcion.Texto</option>
                                }
                            </select>
                            <span asp-validation-for="Motivo" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" class="form-control" inputmode="numeric" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Observacion" class="form-label"></label>
                            <textarea asp-for="Observacion" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Observacion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Registrar movimiento</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Ayudas del formulario (el servidor repite todas las validaciones)
        const stockPorPallet = @Html.Raw(JsonSerializer.Serialize(Model.StockPorPallet));
        const selectorPallet = document.getElementById('PalletId');
        const selectorTipo = document.getElementById('TipoMovimiento');
        const selectorMotivo = document.getElementById('Motivo');
        const disponible = document.getElementById('disponible');

        // Muestra las unidades disponibles del pallet elegido
        function actualizarDisponible() {
            const stock = stockPorPallet[selectorPallet.value];
            if (stock === undefined) { disponible.classList.add('d-none'); return; }
            disponible.textContent = 'Unidades disponibles en el pallet: ' + stock.toLocaleString('es-AR');
            disponible.classList.remove('d-none');
        }

        // Solo se ofrecen los motivos que corresponden al tipo elegido
        function filtrarMotivos() {
            const tipo = selectorTipo.value;
            Array.from(selectorMotivo.options).forEach(function (opcion) {
                if (!opcion.value) return;
                const aplica = !tipo || opcion.dataset.tipos.split(',').includes(tipo);
                opcion.hidden = !aplica;
                opcion.disabled = !aplica;
            });
            const elegida = selectorMotivo.selectedOptions[0];
            if (elegida && elegida.disabled) selectorMotivo.value = '';
        }

        selectorPallet.addEventListener('change', actualizarDisponible);
        selectorTipo.addEventListener('change', filtrarMotivos);
        actualizarDisponible();
        filtrarMotivos();
    </script>
}