@model IEnumerable<PalletListadoViewModel>
@{
    var sucursales = ViewData["Sucursales"] as SelectList;
    ViewData["Title"] = "Pallets";
    var buscar = ViewData["Buscar"] as string;
    var estado = ViewData["Estado"] as string;
    var sucursalId = ViewData["SucursalId"] as int?;
    var esDirector = User.IsInRole(Roles.DirectorEmpresa);
    var total = (int)ViewData["Total"]!;
    var maximo = (int)ViewData["Maximo"]!;
    var hoy = FormatoFecha.HoyArgentina;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="ss-titulo mb-1">Pallets</h1>
        <div class="ss-subtitulo">
            Mercadería almacenada, ordenada por vencimiento.
            @(esDirector ? "Se muestran todas las sucursales de la empresa." : "Se muestran los pallets de su sucursal.")
        </div>
    </div>
    @if (!esDirector)
    {
        <a asp-action="Crear" class="btn btn-primary">Ingresar pallet</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-lg-4">
        <input name="buscar" value="@buscar" class="form-control" placeholder="Buscar por pallet, lote, SKU o producto" />
    </div>
    @if (esDirector)
    {
        <div class="col-sm-6 col-lg-3">
            <select name="sucursalId" class="form-select" asp-items="sucursales">
                <option value="">Todas las sucursales</option>
            </select>
        </div>
    }
    <div class="col-sm-6 col-lg-3">
        <select name="estado" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(estado))">Todas las situaciones</option>
            <option value="conexistencia" selected="@(estado == "conexistencia")">Con existencia</option>
            <option value="agotados" selected="@(estado == "agotados")">Agotados</option>
            <option value="porvencer" selected="@(estado == "porvencer")">Vencen en 30 días</option>
            <option value="vencidos" selected="@(estado == "vencidos")">Vencidos con existencia</option>
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(buscar) || sucursalId.HasValue || !string.IsNullOrEmpty(estado))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="ss-panel">
    <div class="table-responsive">
        <table class="table ss-tabla table-hover mb-0">
            <thead>
                <tr>
                    @if (esDirector)
                    {
                        <th>Sucursal</th>
                    }
                    <th>Pallet</th>
                    <th>Producto</th>
                    <th>Ubicación</th>
                    <th class="text-end">Cantidad</th>
                    <th>Vencimiento</th>
                    <th>Última acción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        @if (esDirector)
                        {
                            <td>@p.Sucursal</td>
                        }
                        <td class="fw-semibold">
                            @p.CodigoPallet
                            @if (!string.IsNullOrEmpty(p.CodigoLote))
                            {
                                <div class="small ss-subtitulo">Lote @p.CodigoLote</div>
                            }
                        </td>
                        <td>@p.Producto<div class="small ss-subtitulo">@p.Sku</div></td>
                        <td>
                            @p.NombreSector
                            @if (!string.IsNullOrEmpty(p.Pasillo) || !string.IsNullOrEmpty(p.Estante))
                            {
                                <div class="small ss-subtitulo">
                                    @(string.IsNullOrEmpty(p.Pasillo) ? "" : "Pasillo " + p.Pasillo)
                                    @(string.IsNullOrEmpty(p.Estante) ? "" : " Estante " + p.Estante)
                                </div>
                            }
                        </td>
                        <td class="text-end">
                            @p.CantidadActual.ToString("N0")
                            <div class="small ss-subtitulo">de @p.CantidadInicial.ToString("N0")</div>
                        </td>
                        <td>
                            @if (p.FechaVencimiento.HasValue)
                            {
                                @p.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                @if (p.CantidadActual > 0 && p.FechaVencimiento.Value < hoy)
                                {
                                    <span class="ss-estado ss-estado-critico ms-1">Vencido</span>
                                }
                                else if (p.CantidadActual > 0 && p.FechaVencimiento.Value <= hoy.AddDays(30))
                                {
                                    <span class="ss-estado ss-estado-alerta ms-1">Por vencer</span>
                                }
                            }
                            else
                            {
                                <span class="ss-subtitulo">No aplica</span>
                            }
                            @if (p.CantidadActual == 0)
                            {
                                <div><span class="ss-estado ss-estado-inactivo">Agotado</span></div>
                            }
                        </td>
                        <td class="ss-auditoria">@p.UltimaAccion</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Detalle</a>
                                @if (!esDirector)
                                {
                                    <a asp-action="Editar" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="@(esDirector ? 8 : 7)" class="text-center ss-subtitulo py-4">No hay pallets para mostrar.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (total > maximo)
{
    <div class="small ss-subtitulo mt-2">Se muestran los primeros @maximo de @total.ToString("N0") pallets. Use los filtros para acotar el resultado.</div>
}