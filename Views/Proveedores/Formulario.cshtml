@model Proveedor
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo proveedor" : "Editar proveedor";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">@ViewData["Title"]</h1>
            <div class="ss-subtitulo">El correo se usa para enviar los pedidos de reposición.</div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@(esNuevo ? null : Model.Id)" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="RazonSocial" class="form-label"></label>
                            <input asp-for="RazonSocial" class="form-control" autofocus />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Cuit" class="form-label"></label>
                            <input asp-for="Cuit" class="form-control" inputmode="numeric" maxlength="11" />
                            <span asp-validation-for="Cuit" class="text-danger"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        @if (!esNuevo && ViewData["Pie"] is PieAuditoriaViewModel pie)
        {
            <partial name="_PieAuditoria" model="pie" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}