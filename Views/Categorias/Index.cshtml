@model IEnumerable<Categoria>
@{
    ViewData["Title"] = "Categorías";
    var usuarios = (Dictionary<string, string>)ViewData["Usuarios"]!;
    var buscar = ViewData["Buscar"] as string;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="ss-titulo mb-1">Categorías</h1>
        <div class="ss-subtitulo">Rubros del catálogo. Definen si el producto controla vencimiento.</div>
    </div>
    <a asp-action="Crear" class="btn btn-primary">Nueva categoría</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5 col-lg-4">
        <input name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="ss-panel">
    <div class="table-responsive">
        <table class="table ss-tabla table-hover mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Vencimiento</th>
                    <th class="text-end">Productos</th>
                    <th>Última acción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td class="fw-semibold">@categoria.Nombre</td>
                    <td>@categoria.Descripcion</td>
                    <td>@(categoria.ControlaVencimiento ? "Controla vencimiento" : "No aplica")</td>
                    <td class="text-end">@categoria.Productos.Count</td>
                    <td class="ss-auditoria">@ServicioAuditoria.UltimaAccion(categoria, usuarios)</td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@categoria.Id" method="post"
                                  data-titulo="Eliminar categoría"
                                  data-confirmar="Se eliminará la categoría '@categoria.Nombre'. Esta acción no se puede deshacer."
                                  data-si="Eliminar">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center ss-subtitulo py-4">No hay categorías para mostrar.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>