@model EmpresaCrearViewModel
@{
    ViewData["Title"] = "Nueva empresa";

    // Dirección del servicio que devuelve las localidades de la provincia elegida
    var urlLocalidades = Url.Action("Localidades", "Ubicaciones", new { area = "" });
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">Nueva empresa</h1>
            <div class="ss-subtitulo">Toda empresa se registra junto con su casa central, que tiene ubicación obligatoria.</div>
        </div>

        <form asp-action="Crear" method="post" data-ubicacion data-url="@urlLocalidades">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="ss-panel mb-3">
                <div class="ss-panel-titulo">Datos de la empresa</div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="RazonSocial" class="form-label"></label>
                            <input asp-for="RazonSocial" class="form-control" autofocus />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Cuit" class="form-label"></label>
                            <input asp-for="Cuit" class="form-control" inputmode="numeric" maxlength="11" />
                            <span asp-validation-for="Cuit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="FechaContrato" class="form-label"></label>
                            <input asp-for="FechaContrato" class="form-control" />
                            <span asp-validation-for="FechaContrato" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ss-panel mb-3">
                <div class="ss-panel-titulo">Casa central</div>
                <div class="p-4">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="CentralCodigo" class="form-label"></label>
                            <input asp-for="CentralCodigo" class="form-control" />
                            <span asp-validation-for="CentralCodigo" class="text-danger"></span>
                        </div>
                        <div class="col-md-9">
                            <label asp-for="CentralNombre" class="form-label"></label>
                            <input asp-for="CentralNombre" class="form-control" />
                            <span asp-validation-for="CentralNombre" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="CentralDireccion" class="form-label"></label>
                            <input asp-for="CentralDireccion" class="form-control" />
                            <span asp-validation-for="CentralDireccion" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CentralProvincia" class="form-label"></label>
                            <select asp-for="CentralProvincia" asp-items="ServicioUbicaciones.Provincias" class="form-select" data-ubicacion-provincia>
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="CentralProvincia" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CentralLocalidad" class="form-label"></label>
                            <input asp-for="CentralLocalidad" class="form-control" data-ubicacion-localidad />
                            <span asp-validation-for="CentralLocalidad" class="text-danger"></span>
                        </div>
                        <div class="col-12 form-text">
                            Ingrese la dirección real (calle, número, localidad y provincia). Se usa para ubicar el local en Google Maps.
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Registrar empresa</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ubicacion.js" asp-append-version="true"></script>
}