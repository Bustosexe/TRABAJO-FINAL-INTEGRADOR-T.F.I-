@model Empresa
@{
    ViewData["Title"] = "Editar empresa";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">Editar empresa</h1>
            <div class="ss-subtitulo">Las sucursales se administran desde la sección Sucursales.</div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="RazonSocial" class="form-label"></label>
                            <input asp-for="RazonSocial" class="form-control" autofocus />
                            <span asp-validation-for="RazonSocial" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Cuit" class="form-label"></label>
                            <input asp-for="Cuit" class="form-control" inputmode="numeric" maxlength="11" />
                            <span asp-validation-for="Cuit" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Telefono" class="form-label"></label>
                            <input asp-for="Telefono" class="form-control" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="FechaContrato" class="form-label"></label>
                            <input asp-for="FechaContrato" class="form-control" />
                            <span asp-validation-for="FechaContrato" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewData["Pie"] is PieAuditoriaViewModel pie)
        {
            <partial name="_PieAuditoria" model="pie" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}