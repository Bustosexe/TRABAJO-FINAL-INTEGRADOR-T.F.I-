@model IEnumerable<CuentaListadoViewModel>
@{
    ViewData["Title"] = "Cuentas de acceso";
    var empresas = ViewData["Empresas"] as SelectList;
    var buscar = ViewData["Buscar"] as string;
    var estado = ViewData["Estado"] as string;
    var empresaId = ViewData["EmpresaId"] as int?;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="ss-titulo mb-1">Cuentas de acceso</h1>
        <div class="ss-subtitulo">Cuentas de Dirección y de sucursal de cada empresa. No se eliminan: se desactivan y se reactivan.</div>
    </div>
    <a asp-action="Crear" asp-route-empresaId="@empresaId" class="btn btn-primary">Nueva cuenta</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-lg-3">
        <select name="empresaId" class="form-select" asp-items="empresas">
            <option value="">Todas las empresas</option>
        </select>
    </div>
    <div class="col-sm-6 col-lg-3">
        <input name="buscar" value="@buscar" class="form-control" placeholder="Buscar por nombre o correo" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <select name="estado" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(estado))">Todas</option>
            <option value="activas" selected="@(estado == "activas")">Activas</option>
            <option value="desactivadas" selected="@(estado == "desactivadas")">Desactivadas</option>
            <option value="pendientes" selected="@(estado == "pendientes")">Con contraseña temporal</option>
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(buscar) || !string.IsNullOrEmpty(estado) || empresaId.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="ss-panel">
    <div class="table-responsive">
        <table class="table ss-tabla table-hover mb-0">
            <thead>
                <tr>
                    <th>Cuenta</th>
                    <th>Empresa</th>
                    <th>Alcance</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    // Textos de confirmación preparados aquí para no anidar comillas en los atributos
                    var tituloEstado = c.Activo ? "Desactivar cuenta" : "Reactivar cuenta";
                    var textoEstado = c.Activo
                        ? $"La cuenta '{c.NombreCuenta}' dejará de poder ingresar y su sesión abierta se cerrará."
                        : $"La cuenta '{c.NombreCuenta}' podrá volver a ingresar con su contraseña actual.";
                    var botonEstado = c.Activo ? "Desactivar" : "Reactivar";
                    var textoRestablecer = $"Se generará una nueva contraseña temporal para '{c.NombreCuenta}'. La contraseña actual dejará de funcionar y su sesión abierta se cerrará.";
                    <tr>
                        <td>
                            <span class="fw-semibold">@c.NombreCuenta</span>
                            <div class="small ss-subtitulo">@c.Email</div>
                        </td>
                        <td>
                            @c.Empresa
                            @if (!c.EmpresaActiva)
                            {
                                <div class="small ss-subtitulo">Empresa suspendida</div>
                            }
                        </td>
                        <td>
                            @if (c.Sucursal == null)
                            {
                                <text>Dirección (todas las sucursales)</text>
                            }
                            else
                            {
                                <text>Sucursal @c.Sucursal</text>
                                if (c.SucursalCerrada)
                                {
                                    <div class="small ss-subtitulo">Sucursal cerrada</div>
                                }
                            }
                        </td>
                        <td>
                            @if (!c.Activo)
                            {
                                <span class="ss-estado ss-estado-inactivo">Desactivada</span>
                            }
                            else if (c.DebeCambiarPassword)
                            {
                                <span class="ss-estado ss-estado-alerta">Contraseña temporal</span>
                            }
                            else
                            {
                                <span class="ss-estado ss-estado-activo">Activa</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Editar" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="Restablecer" asp-route-id="@c.Id" method="post"
                                      data-titulo="Restablecer contraseña"
                                      data-confirmar="@textoRestablecer"
                                      data-si="Restablecer">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Restablecer contraseña</button>
                                </form>
                                <form asp-action="CambiarEstado" asp-route-id="@c.Id" method="post"
                                      data-titulo="@tituloEstado"
                                      data-confirmar="@textoEstado"
                                      data-si="@botonEstado">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@botonEstado</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center ss-subtitulo py-4">No hay cuentas para mostrar.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
