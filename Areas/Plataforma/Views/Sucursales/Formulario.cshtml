@model SucursalFormViewModel
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nueva sucursal" : "Editar sucursal";

    // Dirección del servicio que devuelve las localidades de la provincia elegida
    var urlLocalidades = Url.Action("Localidades", "Ubicaciones", new { area = "" });
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-4">
            <h1 class="ss-titulo mb-1">@ViewData["Title"]</h1>
            <div class="ss-subtitulo">Toda sucursal tiene ubicación real: dirección y coordenadas obligatorias.</div>
        </div>

        <div class="ss-panel">
            <div class="p-4">
                <form asp-action="@(esNuevo ? "Crear" : "Editar")" asp-route-id="@(esNuevo ? null : Model.Id)" method="post" data-ubicacion data-url="@urlLocalidades">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EmpresaId" class="form-label"></label>
                            @if (esNuevo)
                            {
                                <select asp-for="EmpresaId" asp-items="Model.Empresas" class="form-select">
                                    <option value="">Seleccione...</option>
                                </select>
                                <span asp-validation-for="EmpresaId" class="text-danger"></span>
                            }
                            else
                            {
                                <input class="form-control" value="@Model.EmpresaNombre" disabled />
                                @if (Model.EsCasaCentral)
                                {
                                    <div class="form-text">Esta sucursal es la casa central de la empresa.</div>
                                }
                            }
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Codigo" class="form-label"></label>
                            <input asp-for="Codigo" class="form-control" autofocus />
                            <span asp-validation-for="Codigo" class="text-danger"></span>
                        </div>
                        <div class="col-md-9">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Provincia" class="form-label"></label>
                            <select asp-for="Provincia" asp-items="ServicioUbicaciones.Provincias" class="form-select" data-ubicacion-provincia>
                                <option value="">Seleccione...</option>
                            </select>
                            <span asp-validation-for="Provincia" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Localidad" class="form-label"></label>
                            <input asp-for="Localidad" class="form-control" data-ubicacion-localidad />
                            <span asp-validation-for="Localidad" class="text-danger"></span>
                        </div>
                        <div class="col-12 form-text">
                            Ingrese la dirección real (calle, número, localidad y provincia). Se usa para ubicar el local en Google Maps.
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>

        @if (!esNuevo && ViewData["Pie"] is PieAuditoriaViewModel pie)
        {
            <partial name="_PieAuditoria" model="pie" />
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ubicacion.js" asp-append-version="true"></script>
}