@model IEnumerable<Sucursal>
@{
    ViewData["Title"] = "Sucursales";
    var usuarios = (Dictionary<string, string>)ViewData["Usuarios"]!;
    var empresas = ViewData["Empresas"] as SelectList;
    var buscar = ViewData["Buscar"] as string;
    var estado = ViewData["Estado"] as string;
    var empresaId = ViewData["EmpresaId"] as int?;
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
        <h1 class="ss-titulo mb-1">Sucursales</h1>
        <div class="ss-subtitulo">Locales de las empresas clientes. No se eliminan: se cierran y conservan su historial.</div>
    </div>
    <a asp-action="Crear" asp-route-empresaId="@empresaId" class="btn btn-primary">Nueva sucursal</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-lg-3">
        <select name="empresaId" class="form-select" asp-items="empresas">
            <option value="">Todas las empresas</option>
        </select>
    </div>
    <div class="col-sm-6 col-lg-3">
        <input name="buscar" value="@buscar" class="form-control" placeholder="Código, nombre, localidad o dirección" />
    </div>
    <div class="col-sm-4 col-lg-2">
        <select name="estado" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(estado))">Todas</option>
            <option value="activas" selected="@(estado == "activas")">Activas</option>
            <option value="cerradas" selected="@(estado == "cerradas")">Cerradas</option>
        </select>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(buscar) || !string.IsNullOrEmpty(estado) || empresaId.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

<div class="ss-panel">
    <div class="table-responsive">
        <table class="table ss-tabla table-hover mb-0">
            <thead>
                <tr>
                    <th>Empresa</th>
                    <th>Código</th>
                    <th>Sucursal</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th>Última acción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    // El mapa se arma con la dirección real; EscapeDataString protege los caracteres especiales
                    var enlaceMapa = "https://www.google.com/maps/search/?api=1&query="
                        + Uri.EscapeDataString($"{s.Direccion}, {s.Localidad}, {s.Provincia}, Argentina");
                    <tr>
                        <td>@s.Empresa?.RazonSocial</td>
                        <td class="fw-semibold">@s.Codigo</td>
                        <td>
                            @s.Nombre
                            @if (s.EsCasaCentral)
                            {
                                <div class="small ss-subtitulo">Casa central</div>
                            }
                        </td>
                        <td>
                            @s.Direccion
                            <div class="small ss-subtitulo">
                                @s.Localidad, @s.Provincia -
                                <a href="@enlaceMapa" target="_blank" rel="noopener noreferrer">Ver en mapa</a>
                            </div>
                        </td>
                        <td>
                            <span class="ss-estado @(s.Estado == EstadoSucursal.Activa ? "ss-estado-activo" : "ss-estado-inactivo")">
                                @(s.Estado == EstadoSucursal.Activa ? "Activa" : "Cerrada")
                            </span>
                        </td>
                        <td class="ss-auditoria">@ServicioAuditoria.UltimaAccion(s, usuarios)</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                @if (!(s.EsCasaCentral && s.Estado == EstadoSucursal.Activa))
                                {
                                    <form asp-action="CambiarEstado" asp-route-id="@s.Id" method="post"
                                          data-titulo="@(s.Estado == EstadoSucursal.Activa ? "Cerrar sucursal" : "Reabrir sucursal")"
                                          data-confirmar="@(s.Estado == EstadoSucursal.Activa ? $"La sucursal '{s.Nombre}' pasará a Cerrada y sus cuentas de acceso se desactivarán. El historial de stock se conserva." : $"La sucursal '{s.Nombre}' volverá a operar. Sus cuentas se reactivan desde la sección Cuentas.")"
                                          data-si="@(s.Estado == EstadoSucursal.Activa ? "Cerrar" : "Reabrir")">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(s.Estado == EstadoSucursal.Activa ? "Cerrar" : "Reabrir")</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center ss-subtitulo py-4">No hay sucursales para mostrar.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>